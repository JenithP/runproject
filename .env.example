# ⚠️ 이 파일은 "예시 템플릿"입니다 (GitHub에 공개됨).
#    실제 토큰/키/비밀번호는 여기 말고 .env 파일에 넣으세요 (.env는 깃 제외됨).

# ── 텔레그램 봇 ─────────────────────────────────────────
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPQRsTUVwxyz

# webhook 모드용 공개 URL. 로컬 테스트는 비워두면 polling 모드로 동작.
# Netlify 배포 시엔 이 값을 Netlify 환경변수에 넣음 (예: https://kdrunners.netlify.app)
PUBLIC_URL=

# ── Google Gemini Vision (OCR) — 무료 ──────────────────
# https://aistudio.google.com/apikey 에서 무료 발급 (보통 AIza... 로 시작)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx
# 사용할 비전 모델 (무료 한도: flash 계열)
GEMINI_MODEL=gemini-2.5-flash

# ── Firebase / Firestore ───────────────────────────────
# 방법 A) 서비스 계정 JSON 파일 경로 (로컬 개발 권장)
GOOGLE_APPLICATION_CREDENTIALS=./new-membership-e4a2c-firebase-adminsdk-fbsvc-6911fa7682.json
# 방법 B) JSON 내용을 통째로 base64 인코딩 (Netlify 등 배포 환경 권장)
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("서비스계정.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── 웹 관리자 ───────────────────────────────────────────
# 관리자 페이지 접속 비밀번호 (간단 인증)
ADMIN_PASSWORD=changeme

# ── 서버 ────────────────────────────────────────────────
PORT=3000
# 스케줄러/날짜 기준 시간대
TZ=Asia/Seoul
